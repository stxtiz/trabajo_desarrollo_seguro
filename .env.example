# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Proyecto: PNK Security - Trabajo Desarrollo Seguro
# 
# Instrucciones de uso en AWS / Local:
#   1. Copiar este archivo a .env:
#      cp .env.example .env
#   2. Rellenar los valores con tus credenciales y configuración deseada.
#   3. Asegurar que .env tenga permisos restringidos (chmod 600 .env).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERSIÓN DE PHP PARA EL CONTENEDOR DOCKER
# ------------------------------------------------------------------------------
# Opciones disponibles:
#   - 8.5-apache      : Versión moderna PHP 8.5 recomendada (incluye parches de seguridad)
#   - 8.5.12-apache   : Versión fija con parche para CVE-2026-109618 / CVE-2026-109619
#   - 8.3-apache      : Versión LTS estable alternativa
PHP_VERSION=8.5-apache

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE RED Y BASE DE DATOS MYSQL
# ------------------------------------------------------------------------------
# Nombre del host de la base de datos dentro de la red Docker (definido en docker-compose.yml)
MYSQL_HOST=db-prueba

# Nombre de la base de datos de la aplicación
MYSQL_DATABASE=pnk_security

# Usuario no privilegiado para que la aplicación PHP opere con mínimo privilegio
MYSQL_USER=pnk_user

# Contraseña segura para el usuario de la aplicación
# (Reemplazar con una contraseña robusta de al menos 12 caracteres)
MYSQL_PASSWORD=CambiarEstaClaveUsuario123!

# Contraseña administrativa de MySQL (root)
# (Reemplazar con una contraseña administrativa robusta, diferente a la del usuario)
MYSQL_ROOT_PASSWORD=CambiarEstaClaveRoot456!

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y TRANSPORTE HTTP/HTTPS
# ------------------------------------------------------------------------------
# 0 = Permitir tráfico HTTP estándar (útil para pruebas en AWS con IP pública directa)
# 1 = Forzar redirección estricta 301 a HTTPS y emitir cabecera HSTS (para producción con SSL/TLS)
ENFORCE_HTTPS=0
