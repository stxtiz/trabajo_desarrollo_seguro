# =============================================================================
# VARIABLES DE ENTORNO - CARTA DIGITAL PNK SECURITY (OWASP ASVS v5.0 NIVEL 3)
# Copiar como .env y reemplazar con valores criptogr├íficamente seguros en Producci├│n
# =============================================================================

# --- Ambiente (development | test | production) ---
NODE_ENV=development

# --- Base de Datos PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=pnk_security
POSTGRES_USER=pnk_user
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO_32_BYTES
POSTGRES_SSL=false
# Ruta opcional al certificado raíz de AWS RDS (ej. /app/certs/rds-global-bundle.pem) cuando POSTGRES_SSL=true
POSTGRES_SSL_CA=

# --- Seguridad Back-End (ASVS v5.0 Nivel 3) ---
BACKEND_PORT=3000
PASSWORD_PEPPER=REEMPLAZAR_CON_PEPPER_CRIPTOGRAFICO_HEX_64_CHARS
SESSION_IDLE_TIMEOUT_SEC=900
SESSION_ABSOLUTE_TIMEOUT_SEC=14400
CORS_ORIGIN=https://carta-digital.basty46.workers.dev,http://localhost:8080
ENFORCE_HTTPS=0

# --- Front-End ---
FRONTEND_PORT=8080
BACKEND_URL=http://backend:3000

# --- Ambiente QA Automatizado con IA (GitHub Copilot / GitHub Models) ---
# En GitHub Actions se inyecta autom├íticamente ${{ secrets.GITHUB_TOKEN }} (100% gratis)
GITHUB_TOKEN=
GITHUB_AI_MODEL=gpt-4o-mini
QA_TEST_ADMIN_PASSWORD=AdminSegur0!2026#PNK
